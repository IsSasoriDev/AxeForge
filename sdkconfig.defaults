CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# PSRAM (NerdQaxe++ uses an octal-PSRAM ESP32-S3 module)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# web server (up to 10), pools, mempool/weather and a Swarm scan batch (8) together
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_MAX_ACTIVE_TCP=32
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# LVGL 8.3
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_METER=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_DISP_DEF_REFR_PERIOD=33
CONFIG_LV_SPRINTF_USE_FLOAT=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_LV_USE_SNAPSHOT=y
# Stratum V2 Noise transport
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
# TLS buffers in PSRAM (internal RAM is too tight for several TLS sessions)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# keep internal RAM for DMA (SHA engine, LCD, Wi-Fi) - big buffers go to PSRAM
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# check certificate validity dates (TLS waits for NTP before connecting)
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# Bluetooth LE Wi-Fi setup (NimBLE; only started in setup mode, released afterwards)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# controller code in flash instead of ~20 KB of internal RAM; Bluetooth only runs
# during setup, when nothing erases flash
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
# big buffers marked EXT_RAM_BSS_ATTR (the 24-hour charts) live in PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# W5500 Ethernet adapter on the NerdQAxe-family header
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# 802.11k/v: radio measurements and BSS transition, so a mesh can steer the
# miner to its best radio (net/wifi.cpp); the scan cache speeds the move up
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_SCAN_CACHE=y
