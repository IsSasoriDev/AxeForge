# Bitaxe Supra Hex 701/702 build. Used on top of sdkconfig.defaults:
#   idf.py -B build_suprahex -D SDKCONFIG=build_suprahex/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.suprahex" build
CONFIG_AF_BOARD_SUPRAHEX=y
# small bitmap font for the 128x32 OLED
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LWIP_LOCAL_HOSTNAME="axeforge-hex"
