# Bitaxe gammaduo build. Used on top of sdkconfig.defaults:
#   idf.py -B build_gammaduo -D SDKCONFIG=build_gammaduo/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.gammaduo" build
CONFIG_AF_BOARD_GAMMA_DUO=y
# small bitmap font for the 128x32 OLED
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LWIP_LOCAL_HOSTNAME="axeforge-gammaduo"
