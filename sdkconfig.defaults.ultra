# Bitaxe ultra build. Used on top of sdkconfig.defaults:
#   idf.py -B build_ultra -D SDKCONFIG=build_ultra/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.ultra" build
CONFIG_AF_BOARD_BITAXE_ULTRA=y
# small bitmap font for the 128x32 OLED
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LWIP_LOCAL_HOSTNAME="axeforge-ultra"
