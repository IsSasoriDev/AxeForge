# Bitaxe supra build. Used on top of sdkconfig.defaults:
#   idf.py -B build_supra -D SDKCONFIG=build_supra/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.supra" build
CONFIG_AF_BOARD_BITAXE_SUPRA=y
# small bitmap font for the 128x32 OLED
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LWIP_LOCAL_HOSTNAME="axeforge-supra"
